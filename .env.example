APP_NAME=WebErpMesv2
APP_ENV=local
# Set to true to activate commercial white-label branding (Nest2Prod ERP)
APP_COMMERCIAL=false
# Set to true to allow public self-registration (disabled by default for security)
REGISTRATION_ENABLED=false
# Set to true to show the Nest4Quote link in the Quotes menu
NEST4QUOTE_ENABLED=false
# Set to true to show the Nesting link in the Scheduling menu
NESTING_ENABLED=false
# NestEngine — moteur d'imbrication en forme exacte (payant). Activé si
# APP_COMMERCIAL=true ET NESTENGINE_URL renseignée. Sinon l'écran nesting
# retombe sur le rectangle capable local (shelf packing).
NESTENGINE_URL=
NESTENGINE_TIMEOUT=120
NESTENGINE_ROTATIONS=36
NESTENGINE_SPACING=5
NESTENGINE_MAX_SHEETS=50
# Dossier de travail partagé entre Laravel et le service NestEngine local.
# Laravel y copie les DXF de la GED avant chaque job (un sous-dossier
# par jobId). NestEngine doit être lancé avec NEST_INPUTS_DIR=<ce dossier>.
NESTENGINE_INPUTS_DIR=storage/app/nesting-inputs
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

TELESCOPE_ENABLED=false

# CAO — set to true to enable .sym .geo .dxf .step .svg drag-and-drop import on
# quote and order lines. Replaces RADAN_SYM_IMPORT, still honoured as a fallback.
CAD_LINE_IMPORT=false

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=${DB_HOST:-127.0.0.1}
DB_PORT=3306
DB_DATABASE=wem
DB_USERNAME=wem_user
DB_PASSWORD=password

BROADCAST_DRIVER=log
BROADCAST_CONNECTION=pusher
CACHE_DRIVER=redis
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Pusher application credentials pusher.com
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Enables or disables VAT number validation through the VIES service.
# Set to 'true' to enable validation, or 'false' to disable it.
VAT_VALIDATION_ENABLED=false

# Use 'web' as the primary authentication driver for Laravel. Aslo use ldap for the secondary driver.
# This means that the application will use the LDAP server to handle user authentication.
AUTH_DRIVER=web
# Show mode selector (Desktop/Workshop) on the login page.
# Set to false to hide it and default to Desktop mode.
LOGIN_MODE_SELECTOR_ENABLED=false
LDAP_HOST=ldap.example.com
LDAP_USERNAME="cn=admin,dc=example,dc=com"
LDAP_PASSWORD=supersecretpassword
LDAP_PORT=636
LDAP_BASE_DN="dc=example,dc=com"
LDAP_TIMEOUT=10
LDAP_SSL=true
LDAP_TLS=false
LDAP_SASL=false

# Pre-orders import watcher
PRE_ORDERS_MENU_ENABLED=false
PRE_ORDERS_INPUT_PATH=storage\app\public\invoices_files
PRE_ORDERS_OUTPUT_PATH=output
PRE_ORDERS_PROCESSED_PATH=public/output/processed
PRE_ORDERS_FILE_PATTERN=invoices_info*.csv
PRE_ORDERS_PYTHON_EXECUTABLE=
PRE_ORDERS_PYTHON_SCRIPT=
PRE_ORDERS_PYTHON_TIMEOUT=120

# IA — Architecture commune
# Config canonique désormais en base (table ai_settings), éditable dans
#   /admin/integrations/ai. La clé y est chiffrée au repos via APP_KEY.
# Les variables ci-dessous restent lues en fallback tant qu'aucune ligne
# n'a été enregistrée en base — utile pour un premier boot ou un dev local.
ANTHROPIC_API_KEY=
AI_DEFAULT_PROVIDER=claude
AI_CLAUDE_MODEL=claude-haiku-4-5-20251001
AI_CLAUDE_MAX_TOKENS=2048
AI_CLAUDE_TIMEOUT=30
AI_LOGGING=false
AI_QUEUE=default

# IA — Provider Python ML (FastAPI ou command)
AI_PYTHON_MODE=command
AI_PYTHON_URL=http://localhost:8001
AI_PYTHON_TIMEOUT=60

QONTO_CLIENT_ID=
QONTO_CLIENT_SECRET=
QONTO_OAUTH_BASE_URL=https://oauth.qonto.com
QONTO_API_BASE_URL=https://thirdparty.qonto.com/v2

# Facturation électronique — plateforme active ('qonto' ou 'superpdp')
PDP_DRIVER=qonto

# SUPER PDP — Plateforme Agréée. Identifiants créés dans l'interface SUPER PDP
# (Applications → Nouvelle application) : le client_secret ne s'affiche qu'une fois.
# Ce sont les identifiants qui déterminent le mode bac à sable ou production,
# pas l'URL : il n'y a qu'un seul hôte.
SUPERPDP_CLIENT_ID=
SUPERPDP_CLIENT_SECRET=
SUPERPDP_BASE_URL=https://api.superpdp.tech
SUPERPDP_PROCESSING_RULE=B2B
SUPERPDP_PRE_VALIDATE=true

#PULSE
PULSE_DB_CONNECTION=pulse_mysql
PULSE_DB_DATABASE=${DB_DATABASE}
PULSE_INGEST_DRIVER=redis

# Backup
BACKUP_NOTIFICATION_EMAIL=admin@example.com
BACKUP_ARCHIVE_PASSWORD=

# OVH Object Storage (S3-compatible)
OVH_S3_KEY=
OVH_S3_SECRET=
OVH_S3_REGION=gra
OVH_S3_BUCKET=
OVH_S3_ENDPOINT=
